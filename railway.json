{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyMaxRetries": 5,
    "restartPolicyWindowMs": 600000,
    "startCommand": "npm start",
    "healthchecks": {
      "tcp": {
        "disabled": false
      }
    }
  },
  "plugins": [
    "nodejs@latest",
    "postgres@latest"
  ],
  "variables": {
    "NODE_ENV": "production",
    "NEXTAUTH_URL": "${{ RAILWAY_PUBLIC_DOMAIN }}"
  },
  "services": {
    "app": {
      "buildCommand": "npm run build",
      "startCommand": "npm start",
      "variables": {
        "PORT": "3000"
      }
    }
  }
}
