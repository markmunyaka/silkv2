# Database
DATABASE_URL="file:./dev.db"

# OpenAI API for TTS
OPENAI_API_KEY="your_openai_api_key_here"

# Optional: ElevenLabs API (alternative TTS provider)
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"

# Stripe (for future monetization)
STRIPE_PUBLIC_KEY="your_stripe_public_key_here"
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"

# Anthropic API for PDF summarization
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# CloudConvert API for PDF conversion
CLOUDCONVERT_API_KEY="your_cloudconvert_api_key_here"
CLOUDCONVERT_ENABLED="false"

# === B2B Lead Scraper ===
# Google Places API (primary search source)
GOOGLE_PLACES_API_KEY="your_google_places_api_key_here"
# Serper.dev API (fallback search source if Google Places not set)
SERPER_API_KEY="your_serper_api_key_here"
# Hunter.io API (primary email enrichment)
HUNTER_API_KEY="your_hunter_api_key_here"
# Apollo.io API (fallback email enrichment if Hunter not set or no result)
APOLLO_API_KEY="your_apollo_api_key_here"

# === Kling AI Video Generation ===
# Kling 3.0 API credentials for text-to-video generation.
# Obtain these from the Kling Developer Console: https://console.klingai.com
KLING_ACCESS_KEY="your_kling_access_key_here"
KLING_SECRET_KEY="your_kling_secret_key_here"

# === Email Warm-up & Deliverability Optimizer ===
# LLM provider for generating warmup conversation content
# Supported: openai | anthropic | google
WARMUP_LLM_PROVIDER="openai"
WARMUP_LLM_MODEL="gpt-4o-mini"
# Interval between warmup cycles in minutes (default: 5)
WARMUP_CYCLE_INTERVAL_MINUTES=5
# Max messages per inbox per warmup cycle (default: 2)
WARMUP_MAX_MESSAGES_PER_CYCLE=2
# Max messages per thread pair before rotating (default: 6)
WARMUP_MAX_MESSAGES_PER_THREAD=6

# === Twilio WhatsApp Notifications ===
# Twilio credentials for real-time WhatsApp alerts
# Get these from: https://console.twilio.com
# Note: WhatsApp requires a Twilio WhatsApp Business Account
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
# Phone numbers in E.164 format (e.g., +1234567890)
# FROM number should be your Twilio WhatsApp sandbox or verified business number
TWILIO_FROM_NUMBER="+1234567890"
# TO number is your personal phone that will receive alerts
TWILIO_TO_NUMBER="+your_personal_phone_number"
# Alert throttle interval in milliseconds (default: 60000 = 1 minute)
# Prevents spam when pages are refreshed multiple times
ALERT_THROTTLE_INTERVAL=60000

# === Domain Search & Registration (Optional - Mock mode works without these) ===
# The domain search works out-of-the-box with mock data (no API keys needed).
# For real domain availability & pricing, get Namecheap Reseller API credentials:
#   1. Sign up for Namecheap Reseller: https://www.namecheap.com/reseller/
#   2. Get API credentials: https://ap.www.namecheap.com/settings/tools/apiaccess
#   3. Whitelist your server IP in the Namecheap API settings
NAMECHEAP_API_KEY=""
NAMECHEAP_API_USER=""
NAMECHEAP_CLIENT_IP="0.0.0.0"
# Set to "true" to use Namecheap sandbox (test without real purchases)
NAMECHEAP_SANDBOX="true"

# For domain provisioning & SSL (optional - requires Cloudflare for Platforms):
#   1. Sign up: https://www.cloudflare.com/platform/
#   2. Get Account ID from Cloudflare dashboard
#   3. Generate API Token with "Zone:Edit" permissions
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_NAME=""
CLOUDFLARE_DEFAULT_ORIGIN=""

# === TransUnion TLOxp Identity Verification ===
# API base URL for TLOxp (default: https://api.tlo.transunion.com/v1)
# TLO_API_BASE_URL="https://api.tlo.transunion.com/v1"
# API key for TransUnion TLOxp (required in production)
TLO_API_KEY=""
# Match threshold score (0-100). Defaults to 70. Scores >= threshold are considered verified.
# TLO_MATCH_THRESHOLD=70
# Default permissible use code (default: GLBA_FRAUD_PREVENTION)
# TLO_DEFAULT_PERMISSIBLE_USE="GLBA_FRAUD_PREVENTION"
# NOTE: In development (NODE_ENV=development), the service uses a mock layer
# automatically and does NOT require API keys to be set.
