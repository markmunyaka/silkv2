# ============================================================================
# ENTERPRISE-SECURE PDF SUMMARIZER - ENVIRONMENT CONFIGURATION
# ============================================================================
# This file documents all required and optional environment variables.
# Copy to .env and fill in with your actual values.
# NEVER commit .env files with real secrets to version control!
#
# Security Standard: OWASP Top 10 for LLMs
# ============================================================================

# ============================================================================
# CORE SERVER CONFIGURATION
# ============================================================================
FASTAPI_ENV=development
FASTAPI_DEBUG=false
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ============================================================================
# ANTHROPIC CLAUDE API (REQUIRED)
# ============================================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# LAKERA GUARD - PROMPT INJECTION FIREWALL (REQUIRED FOR PRODUCTION)
# ============================================================================
# Lakera Guard: Real-time prompt injection detection
# Sign up at: https://www.lakera.ai/
# 
# CRITICAL: This is your primary defense against prompt injection attacks (OWASP LLM01)
LAKERA_GUARD_API_KEY=your-lakera-guard-api-key-here
LAKERA_GUARD_ENABLED=true

# ============================================================================
# MICROSOFT PRESIDIO - PII DETECTION & REDACTION
# ============================================================================
# Automatically detect and mask:
# - Names, Email addresses, Phone numbers
# - Credit cards, SSNs, ID numbers
# - Addresses, IP addresses, URLs
# - Financial data
#
# Local deployment (no API calls). Pre-installed models.
PRESIDIO_ENABLED=true

# ============================================================================
# GUARDRAILS AI - OUTPUT VALIDATION
# ============================================================================
# Validates LLM output against security guardrails:
# - Detects executable code (Python, Bash, JavaScript, SQL)
# - Blocks credential/API key exposure
# - Prevents jailbreak instructions and system prompt override
# - Detects SQL injection patterns
# - Blocks dangerous function calls
#
# CRITICAL: This is your defense against insecure output handling (OWASP LLM02)
GUARDRAILS_ENABLED=true

# ============================================================================
# OPTIONAL: VOTIRO / CDR SANITIZATION
# ============================================================================
# Content Disarm & Reconstruction: Remove macros, scripts, embedded objects
# Sign up at: https://www.votiro.com/
#
# If disabled, PDFs are accepted as-is (higher risk)
VOTIRO_API_KEY=your-votiro-api-key-here
VOTIRO_ENABLED=false

# ============================================================================
# LANGSMITH - FORENSICS & REQUEST TRACING
# ============================================================================
# Audit trail and debugging for all LLM calls
# Sign up at: https://smith.langchain.com/
#
# Required if TRACE_REQUESTS=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=pdf-summarizer-security

# ============================================================================
# WATERMARKING & INTEGRITY
# ============================================================================
# Secret key for digital signatures (MUST be 32+ characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WATERMARK_SECRET_KEY=your-secret-key-minimum-32-characters-long
WATERMARK_ALGORITHM=HS256

# ============================================================================
# PII DE-ANONYMIZATION
# ============================================================================
# Encryption key for client-side PII restoration
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRITICAL: Store securely, never log or transmit insecurely
PII_DEANON_KEY=your-fernet-encryption-key-here
PII_DEANON_TTL_MINUTES=60

# ============================================================================
# RATE LIMITING - WALLET-JACKING PREVENTION
# ============================================================================
# Token-based rate limiting to prevent DDoS and API credit drains
#
# Global limits (all users combined)
GLOBAL_REQUESTS_PER_MINUTE=1000
GLOBAL_TOKENS_PER_MINUTE=50000

# Per-IP limits
IP_REQUESTS_PER_MINUTE=100
IP_TOKENS_PER_MINUTE=5000

# Per-user limits (authenticated users)
USER_REQUESTS_PER_MINUTE=200
USER_TOKENS_PER_MINUTE=10000

# Operation costs (in tokens)
# Higher cost = more expensive, limits abuse
TOKEN_COST_PDF_UPLOAD=100
TOKEN_COST_LLM_CALL=500
TOKEN_COST_API_CALL=50

# Block duration after rate limit violation (seconds)
RATE_LIMIT_BLOCK_DURATION=300

# ============================================================================
# FILE UPLOAD RESTRICTIONS
# ============================================================================
MAX_FILE_SIZE_MB=10
UPLOAD_TEMP_DIR=./temp/uploads
ALLOWED_CONTENT_TYPES=application/pdf

# ============================================================================
# SECURITY LOGGING
# ============================================================================
# ALL security incidents are logged with tamper-detection
# 
# Logs include:
# - Jailbreak/prompt injection attempts
# - Rate limit violations
# - PII exposure attempts
# - Output validation failures
# - Suspicious activities
#
# Log file format: JSON Lines (one incident per line, HMAC signed)
LOG_LEVEL=INFO
SECURITY_LOG_FILE=./logs/security_incidents.jsonl
SECURITY_LOG_SIGNING_KEY=secure-llm-incident-logger

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# REQUEST TRACING & FORENSICS
# ============================================================================
# Enable detailed tracing of all requests (requires LANGSMITH_API_KEY)
TRACE_REQUESTS=true

# Anonymize PII in traces (removes names, emails, phone numbers from logs)
ANONYMIZE_TRACE_DATA=false

# ============================================================================
# SECURITY HARDENING CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
#
# [ ] ANTHROPIC_API_KEY is set and valid
# [ ] LAKERA_GUARD_API_KEY is set (prompt injection defense)
# [ ] LAKERA_GUARD_ENABLED=true
# [ ] PRESIDIO_ENABLED=true (PII detection)
# [ ] GUARDRAILS_ENABLED=true (output validation)
# [ ] WATERMARK_SECRET_KEY is a strong, random 32+ char string
# [ ] PII_DEANON_KEY is a valid Fernet key
# [ ] LOG_LEVEL=WARNING (not DEBUG in production)
# [ ] FASTAPI_DEBUG=false
# [ ] CORS_ORIGINS is restricted (not "*")
# [ ] All API keys are stored in secrets manager, NOT in .env
# [ ] Security log file path is on encrypted/protected storage
# [ ] Rate limiting is tuned for your expected load
# [ ] SSL/TLS is enforced for all communications
#
# ============================================================================
# SECURITY LOG VERIFICATION
# ============================================================================
# Verify log integrity with:
#   python -c "from app.security import SecurityIncidentLogger; 
#             logger = SecurityIncidentLogger('./logs/security_incidents.jsonl', 'key');
#             is_valid, msg = logger.verify_log_integrity();
#             print(f'Valid: {is_valid}\\nReport: {msg}')"
#
# ============================================================================
